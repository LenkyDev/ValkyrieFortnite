{
	"$schema": "http://json-schema.org/schema#",
	"$id": "http://epicgames.com/schemas/valkyrie/auto-localization.json",
	"description": "ContentSentry validation auto-localization",
	"type": "object",
	
	"required": ["Version", "TranslatedStringHashes"],
  
	"properties": {

		"Version": {
			"type": "integer",
			"exclusiveMinimum": 0
		},
		
		"TranslatedStringHashes": {
			"type": "array",
			"items": {
				"type": "object",
				"properties":{
					"Culture": {
						"type": "string"
					},
					"Hashes": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 64,
							"maxLength": 64
						},
						"minItems": 1
					}
				},
				"required": ["Culture", "Hashes"]
			}
		}
	}
}