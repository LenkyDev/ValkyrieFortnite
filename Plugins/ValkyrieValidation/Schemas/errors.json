{
	"$schema": "http://json-schema.org/schema#",
	"$id": "http://epicgames.com/schemas/valkyrie/errors.json",
	"description": "ContentSentry validation errors",
	"type": "object",
	
	"anyOf": [
		{ "required": ["additionalErrors"] },
		{ "required": ["errorCode"] },
		{ "required": ["errorMessage"] }
	],
  
	"properties": {
		"additionalErrors": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"minItems": 1
		},
		"errorCode": {
			"type": "string"
		},
		"errorMessage": {
			"type": "string"
		}
	}
}