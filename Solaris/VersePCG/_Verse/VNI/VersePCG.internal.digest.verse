# Verse path: /UnrealEngine.com/PCG
# Module import path: /UnrealEngine.com/PCG/VersePCG
VersePCG<public> := module:
    using {/Verse.org/Simulation/Tags}
    using {/Verse.org/Assets}
    using {/Verse.org/Simulation}
    using {/Verse.org/SceneGraph}
    using {/Verse.org/Native}
    @import_as("/Script/VersePCG.UPCGEntityComponentExecutionSource")
    pcg_execution_source<native><epic_internal> := class<epic_internal>:


    @experimental
    # PCG Component
    pcg_component<native><epic_internal> := class<final_super>(component):
        # The `pcg graph` to be generated by this `pcg_component`.
        Graph<native><epic_internal>:pcg_graphinterface_asset = external {}

        @editable
        var<private> Seed<native><public>:int = external {}

    pcg_graphinterface_asset<native><epic_internal> := interface<computes><epic_internal>:


    pcg_graph_asset<native><epic_internal> := class<concrete><computes><final><epic_internal>(asset, pcg_graphinterface_asset):


    pcg_graphinstance_asset<native><epic_internal> := class<concrete><computes><final><epic_internal>(asset, pcg_graphinterface_asset):


    pcg_base_tag<native><epic_internal> := class<abstract>(tag):


    pcg_generated_tag<native><epic_internal> := class(pcg_base_tag):
